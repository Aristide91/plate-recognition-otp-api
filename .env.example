# Environment variables for FastAPI Backend

# FastAPI Secret Key (change this in production!)
SECRET_KEY="supersecretkey"

# Keycloak Configuration
KEYCLOAK_REALM_URL="http://localhost:8080/realms/master"
KEYCLOAK_CLIENT_ID="fastapi-client"
KEYCLOAK_CLIENT_SECRET="your-keycloak-client-secret"

# Twilio Configuration (for SMS OTP)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15017122661"

# SMTP Configuration (for Email OTP - example with Gmail)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your_email@gmail.com"
SMTP_PASSWORD="your_email_password"
SENDER_EMAIL="your_email@gmail.com"
